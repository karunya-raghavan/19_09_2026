class Solution:
    def rightSideView(self, root: TreeNode | None) -> list[int]:
        
        def post_reverse_order(node,level,ans):
            if node is None:
                return
            if len(ans)==level:
                ans.append(node.val)
            if node.right:
                post_reverse_order(node.right,level+1,ans)
            if node.left:
                post_reverse_order(node.left,level+1,ans)
            
        ans=[]
        post_reverse_order(root,0,ans)
        return ans
